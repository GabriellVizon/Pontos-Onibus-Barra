  "rules": {
    "no-unused-vars": "warn",
    "no-undef": "error",
    "no-console": "off",
    "no-var": "off",
    "no-empty": "off"
  },
  "overrides": [
    {
      "files": ["js/utils.js", "js/horarios.js"],
      "rules": {
        "no-unused-vars": "off"
      }
    }
  ],
  "ignorePatterns": [
    "node_modules/",
    "package-lock.json"
  ]
}
